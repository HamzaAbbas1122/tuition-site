// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  role      String   @default("STUDENT")
  createdAt DateTime @default(now())
  
  // Relations
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  teacherClasses TuitionClass[] @relation("TeacherClasses")
  studentClasses TuitionClass[] @relation("StudentClasses")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  grade     String?
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  subjects  String?
  grades    String?
}

model StudentApplication {
  id          String    @id @default(cuid())
  studentName String
  parentName  String
  phone       String
  subject     String
  grade       String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
}

model TeacherApplication {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String
  subjects  String
  grades    String?
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
}

model TuitionClass {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  subject   String
  grade     String?
  isActive  Boolean  @default(true)

  
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  student   User     @relation("StudentClasses", fields: [studentId], references: [id])
  sessions  ClassSession[]
  payments  Payment[]
}

model ClassSession {
  id                    String        @id @default(cuid())
  tuitionId             String
  date                  DateTime
  endTime               DateTime
  status                String        @default("SCHEDULED")
  classLink             String?
  
  rescheduleRequestedBy String?
  rescheduleProposedTime DateTime?
  rescheduleProposedEndTime DateTime?
  rescheduleReason      String?
  rescheduleStatus      String?
  
  tuition     TuitionClass  @relation(fields: [tuitionId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  tuitionId   String
  amount      Float
  status      String   @default("UNPAID")
  dueDate     DateTime
  paidDate    DateTime?
  
  tuition     TuitionClass @relation(fields: [tuitionId], references: [id])
}
