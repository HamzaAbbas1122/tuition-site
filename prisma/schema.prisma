// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AppStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ClassStatus {
  SCHEDULED
  COMPLETED
  MISSED
  PENDING
  RESCHEDULED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  
  // Relations
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  teacherClasses TuitionClass[] @relation("TeacherClasses")
  studentClasses TuitionClass[] @relation("StudentClasses")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  grade     String?
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  subjects  String?
}

model StudentApplication {
  id          String    @id @default(cuid())
  studentName String
  parentName  String
  phone       String
  subject     String
  status      AppStatus @default(PENDING)
  createdAt   DateTime  @default(now())
}

model TeacherApplication {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String
  subjects  String
  status    AppStatus @default(PENDING)
  createdAt DateTime  @default(now())
}

model TuitionClass {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  subject   String
  isActive  Boolean  @default(true)
  
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  student   User     @relation("StudentClasses", fields: [studentId], references: [id])
  sessions  ClassSession[]
  payments  Payment[]
}

model ClassSession {
  id          String        @id @default(cuid())
  tuitionId   String
  date        DateTime
  endTime     DateTime
  status      ClassStatus   @default(SCHEDULED)
  classLink   String?
  rescheduledTo DateTime?
  
  tuition     TuitionClass  @relation(fields: [tuitionId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  tuitionId   String
  amount      Float
  status      String   @default("UNPAID")
  dueDate     DateTime
  paidDate    DateTime?
  
  tuition     TuitionClass @relation(fields: [tuitionId], references: [id])
}
